{
  "name": "story-film-skills",
  "version": "0.0.25",
  "private": true,
  "description": "Local-first Agent Skills for story, book, screenplay, image, audio, video, film, postproduction, and release workflows.",
  "license": "Apache-2.0",
  "author": "Alan Guice (Badgids)",
  "scripts": {
    "bundle": "python3 scripts/build_npx_bundle.py",
    "bundle:check": "python3 scripts/build_npx_bundle.py --check",
    "test": "python3 scripts/regression_suite.py",
    "docs:check": "python3 scripts/check_docs.py",
    "examples:check": "python3 scripts/validate_examples.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "story",
    "film",
    "comfyui",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./extensions/story-film-progress/index.ts",
      "./extensions/story-film-comfy/index.ts"
    ],
    "skills": [
      "./skills/*/SKILL.md",
      "!./skills/story-film-suite/SKILL.md"
    ]
  }
}
